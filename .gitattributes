# The pre-commit hook must keep LF endings. Git on Windows converts to CRLF on
# checkout by default, and a shell script with CRLF fails at the shebang with
# "bad interpreter". The guard would then be silently absent on a fresh clone,
# which is the worst way for a guard to fail.
.githooks/* text eol=lf
*.sh text eol=lf

# Keep line endings stable for everything else that is read by a tool rather
# than a person.
*.py text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.json text eol=lf
